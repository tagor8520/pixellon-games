# CDN / static-host headers (Netlify, Cloudflare Pages, and anything that reads
# `_headers`). Keep this in sync with server/standalone.js `cachePolicy()`.
#
# The rule that matters: hashed assets are immutable, HTML is never cached.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: SAMEORIGIN

# Vite fingerprints everything under /assets, so it can live in caches forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML entry is what points at the new hashes — revalidate it every time.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icons.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The API sets its own Cache-Control/CDN-Cache-Control per route (server/config.js).
# Never let a blanket rule override it: those s-maxage values are the cost model.
/api/*
  Cache-Control: no-transform
