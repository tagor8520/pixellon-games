# Copy to `.env` and fill in. Never commit the real file.
#
# Rule: credentials are server-side only. Do NOT add a VITE_ prefix to anything
# here — VITE_* variables are inlined into the public JavaScript bundle.

RAWG_API_KEY=            # https://rawg.io/apidocs  (free tier: 20k req/month)
STEAM_WEB_API_KEY=       # https://steamcommunity.com/dev/apikey
TWITCH_CLIENT_ID=        # https://dev.twitch.tv/console/apps  (also powers IGDB)
TWITCH_APP_TOKEN=
PANDASCORE_API_KEY=      # https://developers.pandascore.co

# Optional tunables — see server/config.js for the cache policy table.
API_CACHE_MAX_ENTRIES=2000
API_RATE_LIMIT=240
API_TTL_SCALE=1
UPSTREAM_TIMEOUT_MS=8000
# API_CORS_ORIGIN=
# NEWS_FEED_URL=https://feeds.feedburner.com/ign/news
